# /etc/systemd/system/myiu-fortress.service
[Unit]
Description=MyIu Fortress API Service
After=network.target

[Service]
WorkingDirectory=/root/myiu-brain-core
ExecStart=/root/myiu-brain-core/myiu_env/bin/uvicorn fortress_api:app --host 0.0.0.0 --port 12440
Restart=always
User=root

[Install]
WantedBy=multi-user.target
